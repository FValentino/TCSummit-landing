# ----------------------------------------
# TC Summit — Variables de Entorno
# ----------------------------------------
# Copiá este archivo como .env y completá los valores
# NUNCA subir .env a GitHub

# Base de datos
DATABASE_URL=postgresql://user:password@localhost:5432/tcsummit

# Resend (emails)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=tickets@tcsummit.net

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_EVENT_ID=your-event-id-here
